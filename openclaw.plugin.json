{
  "id": "openclaw-guard",
  "name": "OpenClaw Guard",
  "description": "OpenClaw 安全监控、诊断修复、知识库管理插件 - 提供实时安全监控、漏洞扫描、合规检查、自动修复等能力",
  "version": "1.0.2",
  "kind": "security",
  "install": {
    "method": "npm",
    "command": "npm install -g openclaw-guard",
    "buildCommand": "npm run build",
    "requirements": {
      "node": ">=18.0.0",
      "npm": ">=9.0.0"
    }
  },
  "permissions": {
    "filesystem": {
      "read": ["~/.openclaw", "~/.openclaw-guard", "/etc/openclaw"],
      "write": ["~/.openclaw", "~/.openclaw-guard"]
    },
    "network": {
      "outbound": true,
      "description": "用于知识库同步、告警推送、AI 辅助诊断"
    },
    "process": {
      "spawn": true,
      "daemon": true,
      "description": "用于监控守护进程和系统诊断命令执行"
    }
  },
  "env": {
    "optional": [
      {
        "name": "OPENCLAW_GUARD_AI_API_KEY",
        "description": "AI 辅助诊断的 API Key（可选）"
      },
      {
        "name": "OPENCLAW_GUARD_AI_ENDPOINT",
        "description": "AI 辅助诊断的 API 端点（可选）"
      }
    ]
  },
  "security": {
    "dataHandling": {
      "localOnly": ["配置文件", "诊断日志", "备份文件"],
      "externalTransmit": ["告警通知", "知识库同步", "AI 诊断请求"],
      "credentialStorage": "本地 JSON 文件，未加密"
    },
    "auditLog": true,
    "userConsent": ["首次配置告警渠道时", "首次配置远程知识库时", "启用自动修复时"]
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "monitorEnabled": {
        "type": "boolean",
        "default": true,
        "description": "启用安全监控"
      },
      "monitorLevel": {
        "type": "string",
        "enum": ["critical", "high", "medium", "low"],
        "default": "medium",
        "description": "监控告警最低级别"
      },
      "webhookUrl": {
        "type": "string",
        "description": "告警 Webhook 地址"
      },
      "dingtalkWebhook": {
        "type": "string",
        "description": "钉钉机器人 Webhook"
      },
      "wecomWebhook": {
        "type": "string",
        "description": "企业微信机器人 Webhook"
      },
      "feishuWebhook": {
        "type": "string",
        "description": "飞书机器人 Webhook"
      },
      "knowledgeRemoteUrl": {
        "type": "string",
        "description": "远程知识库同步地址"
      },
      "knowledgeSyncInterval": {
        "type": "number",
        "default": 24,
        "description": "知识库自动同步间隔（小时）"
      },
      "networkMonitoring": {
        "type": "boolean",
        "default": false,
        "description": "启用网络连接监控"
      },
      "deviceMonitoring": {
        "type": "boolean",
        "default": false,
        "description": "启用设备配对监控"
      },
      "gatewayPorts": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "default": [18789],
        "description": "要监控的 Gateway 端口"
      },
      "autoFix": {
        "type": "boolean",
        "default": false,
        "description": "启用自动修复"
      },
      "aiDiagnosis": {
        "type": "boolean",
        "default": false,
        "description": "启用 AI 辅助诊断"
      }
    },
    "additionalProperties": false
  },
  "skills": ["skills/security-guard"],
  "uiHints": {
    "fields": {
      "webhookUrl": {
        "label": "告警 Webhook",
        "placeholder": "https://your-webhook-url/alert"
      },
      "dingtalkWebhook": {
        "label": "钉钉告警",
        "placeholder": "https://oapi.dingtalk.com/robot/send?access_token=..."
      },
      "wecomWebhook": {
        "label": "企业微信告警",
        "placeholder": "https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=..."
      },
      "feishuWebhook": {
        "label": "飞书告警",
        "placeholder": "https://open.feishu.cn/open-apis/bot/v2/hook/..."
      },
      "knowledgeRemoteUrl": {
        "label": "知识库同步地址",
        "placeholder": "https://your-server/knowledge.json"
      }
    }
  }
}
