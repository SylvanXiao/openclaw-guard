{
  "name": "openclaw-guard",
  "version": "1.0.0",
  "description": "OpenClaw security monitoring, diagnostics, and knowledge management plugin",
  "main": "dist/plugin.js",
  "types": "dist/plugin.d.ts",
  "bin": {
    "openclaw-guard": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js",
      "require": "./dist/plugin.js"
    },
    "./cli": "./dist/index.js"
  },
  "openclaw": {
    "extensions": ["./dist/plugin.js"],
    "compat": {
      "pluginApi": ">=2026.0.0"
    }
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "skills"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "openclaw",
    "plugin",
    "guard",
    "security",
    "monitor",
    "diagnostics",
    "cve",
    "compliance"
  ],
  "author": "SylvanXiao",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SylvanXiao/openclaw-guard.git"
  },
  "bugs": {
    "url": "https://github.com/SylvanXiao/openclaw-guard/issues"
  },
  "homepage": "https://github.com/SylvanXiao/openclaw-guard#readme",
  "peerDependencies": {
    "openclaw": ">=2026.0.0"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "dependencies": {
    "@types/blessed": "^0.1.27",
    "@types/tar": "^6.1.13",
    "blessed": "^0.1.81",
    "blessed-contrib": "^4.11.0",
    "chalk": "^4.1.2",
    "chokidar": "^3.6.0",
    "commander": "^12.0.0",
    "execa": "^5.1.1",
    "fs-extra": "^11.2.0",
    "inquirer": "^8.2.6",
    "ora": "^5.4.1",
    "semver": "^7.6.0",
    "tar": "^7.5.11",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^9.0.7",
    "@types/node": "^20.11.0",
    "@types/semver": "^7.5.8",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
